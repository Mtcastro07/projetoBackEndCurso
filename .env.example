NODE_ENV=development
PORT=3333
HOST="0.0.0.0"

# ERRO: havia a linha solta "src/@types/prima" aqui (parece um trecho de .gitignore
# colado por engano). Nao e um par CHAVE=valor, entao o dotenv ignorava, mas polui o
# arquivo de exemplo. Removida.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=postgres
POSTGRES_PORT=5432

HASH_SALT_ROUNDS=12

# URL de conexao que o Prisma usa (montada a partir das variaveis POSTGRES_* acima)
DATABASE_URL="postgresql://postgres:123456@localhost:5432/postgres?schema=public"

